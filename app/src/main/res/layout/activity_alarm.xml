<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="16dp">

    <TextClock
        android:id="@+id/ringTime"
        android:format12Hour="HH:mm"
        android:format24Hour="HH:mm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/muted"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:letterSpacing="0.2"
        android:text="지금 할 일"
        android:textColor="@color/danger"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- 할일: 남은 공간을 꽉 채우도록 글자 크기 자동 조절 -->
    <TextView
        android:id="@+id/ringTodo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginVertical="8dp"
        android:layout_weight="1"
        android:autoSizeMaxTextSize="400sp"
        android:autoSizeMinTextSize="24sp"
        android:autoSizeStepGranularity="2sp"
        android:autoSizeTextType="uniform"
        android:breakStrategy="balanced"
        android:gravity="center"
        android:lineSpacingMultiplier="0.95"
        android:textColor="@color/accent"
        android:textStyle="bold" />

    <Button
        android:id="@+id/doneBtn"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:background="@drawable/rounded"
        android:backgroundTint="@color/ok"
        android:text="✔ 완료 · 끄기"
        android:textColor="#000000"
        android:textSize="30sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/snoozeBtn"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/rounded"
        android:backgroundTint="@color/btn"
        android:text="5분 뒤 다시"
        android:textColor="@color/text"
        android:textSize="22sp"
        android:textStyle="bold" />
</LinearLayout>
